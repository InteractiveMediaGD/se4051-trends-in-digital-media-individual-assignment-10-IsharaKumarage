# Unity .gitignore — Smart Relaxation Room
# Excludes generated folders that should NOT be submitted

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emory[Cc]aptures/
[Rr]ecordings/

# Unity crash log
sysinfo.txt
crashlytics-build.properties

# Unity cache files
*.pidb
*.suo
*.userprefs
*.unityproj
*.DS_Store
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# VS Code / Visual Studio
.vs/
*.csproj
*.sln
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Builds
ExportedObj/
*.apk
*.aab
*.unitypackage

# Test results
TestResults/

# What TO submit (kept in repo):
# Assets/
# Packages/
# ProjectSettings/
